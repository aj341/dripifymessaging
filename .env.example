# Design Bees Hive — environment
# On Railway these are set in the service's Variables, never committed here.

# Provided automatically by Railway when you reference the Postgres service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Telegram bot (create via @BotFather). REGENERATE the token before storing it.
TELEGRAM_BOT_TOKEN=

# Optional: the chat id the hive talks in. If left blank, the bridge captures it
# automatically the first time you message the bot.
TELEGRAM_CHAT_ID=

# Optional: shared secret workers must send to write to the brain over the API.
# If unset, the write API is open (fine while everything is internal to Railway).
WORKER_API_KEY=

# Port is provided by Railway automatically.
PORT=3000
